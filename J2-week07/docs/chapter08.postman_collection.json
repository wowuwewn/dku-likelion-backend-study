{
  "info": {
    "name": "Chapter 08 회원가입",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090"
    }
  ],
  "item": [
    {
      "name": "정상 가입: 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/members",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"postman-{{$guid}}\",\"password\":\"example-only\",\"nickname\":\"API example\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Response envelope\", () => { const b = pm.response.json(); pm.expect(b).to.have.all.keys(\"resultCode\",\"statusCode\",\"msg\",\"data\"); pm.expect(b.resultCode).to.eql(\"201-1\"); pm.expect(b.statusCode).to.eql(201); });",
              "pm.test(\"No password field\", () => pm.expect(pm.response.text()).not.to.include('\"password\"'));"
            ]
          }
        }
      ]
    },
    {
      "name": "중복 아이디: 400",
